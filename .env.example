# Copy to .env (gitignored).  Read by compose and by ./update.

# The uid the containers run as: yours (`id -u`), so the projects and
# src/ stay writable for you.  Changing it needs `compose build`.
HOST_UID=1000

# Each host's directory of projects, mounted at /projects in its own
# container.  Every directory in it is a project, usually a git
# repository, with its own lobby; ./project adds and removes them.
PRIVATE_PROJECTS=./projects/private
PUBLIC_PROJECTS=./projects/public

# Further Arch packages for the image, space-separated, e.g. `jdk-openjdk
# r'.  The model cannot install system packages itself; ./update rebuilds
# the image when this changes.  Python and Node packages need no entry:
# the model installs those with uv and npm.
EXTRA_PACKAGES=

# Sources ./update clones into src/ and keeps at the branch tip.  A local
# path works too, e.g. MEVEDEL_REPO=/home/roland/Projekte/mevedel, but only
# committed changes reach the containers.
MEVEDEL_REPO=https://github.com/FrauH0lle/mevedel.git
MEVEDEL_BRANCH=master
GPTEL_REPO=https://github.com/FrauH0lle/gptel.git
GPTEL_BRANCH=local-fixes-effort

# Localhost: run ~/Projekte/mevedel/relay/relay on this machine.
MEVEDEL_RELAY_URL=ws://127.0.0.1:7466
MEVEDEL_RELAY_HOST_TOKEN=

# Deployed relay: the URL and host token from site-lisp/config.el.
# MEVEDEL_RELAY_URL=wss://mevedel.skadonk.me
# MEVEDEL_RELAY_HOST_TOKEN=...
