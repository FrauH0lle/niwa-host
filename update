#!/bin/sh
# Bring src/niwa and src/gptel to their branch tips, migrate persisted state
# while the hosts are stopped, then start the hosts again.
#
# Refuses while any host is running a turn, so it is safe to run nightly
# (./setup installs a timer for that).  --force overrides that busy check;
# --rebuild also rebuilds the image, for Emacs or ELPA dependency changes.
# Even unchanged sources need an offline migration check.  Migration failures
# leave the hosts stopped, with the migrator's original-session backups intact.
# Fetching and building happen before the hosts stop, so a network or build
# failure leaves them running the old code.
set -eu
. "$(dirname "$0")/common.sh"
# Serialize manual updates and the nightly timer, including source changes
# and the entire offline migration/startup window.
exec 9>.update.lock
if ! flock -n 9; then
  echo "Another update is running; not updating" >&2
  exit 1
fi
services=$(hosts)
force= rebuild=
case ${1:-} in
  --force) force=1 ;;
  --rebuild) force=1 rebuild=1 ;;
  ?*) echo "usage: ./update [--force|--rebuild]" >&2; exit 1 ;;
esac

if [ -z "$force" ]; then
  for service in $services; do
    if busy "$service"; then
      echo "niwa-$service is running a turn or not answering; not updating (--force overrides)"
      exit 1
    fi
  done
fi

# The clones are deployment copies: the branch tip wins, even after a
# force push, and nothing local is kept but ignored bytecode.  Fetched
# now, checked out once the hosts are stopped.
fetch() { # DIR REPO BRANCH
  if [ -d "$1/.git" ]; then
    git -C "$1" fetch -q "$2" "$3"
    git -C "$1" rev-parse FETCH_HEAD
  fi
}
checkout() { # DIR REPO BRANCH REVISION
  if [ -n "$4" ]; then
    git -C "$1" reset -q --hard "$4"
  else
    git clone -q --branch "$3" "$2" "$1"
  fi
}

revisions() {
  for dir in src/niwa src/gptel; do
    git -C "$dir" rev-parse HEAD 2>/dev/null || echo none
  done
}

mkdir -p src
niwa_rev=$(fetch src/niwa "$NIWA_REPO" "$NIWA_BRANCH")
gptel_rev=$(fetch src/gptel "$GPTEL_REPO" "$GPTEL_BRANCH")

# Built here rather than by compose, with host networking like the hosts
# themselves: the rootless network helper (pasta) crashes in some LXC
# containers, and compose cannot pass the build a network.
# A changed EXTRA_PACKAGES in .env or a change to the files the image is
# built from rebuilds it too.  Running hosts keep their image until they
# are recreated.
image=localhost/niwa-host:latest
extra=${EXTRA_PACKAGES:-}
kit=$(cat Dockerfile install.el compile.el entrypoint.sh | sha256sum | cut -c1-16)
if [ -n "$rebuild" ] \
   || ! built=$("$runtime" image inspect --format \
                  '{{index .Config.Labels "niwa-host.extra-packages"}} {{index .Config.Labels "niwa-host.kit"}}' \
                  "$image" 2>/dev/null) \
   || [ "$built" != "$extra $kit" ]; then
  "$runtime" build --network host --build-arg HOST_UID="${HOST_UID:-1000}" \
    --build-arg EXTRA_PACKAGES="$extra" --build-arg KIT="$kit" -t "$image" .
fi

# Old code must save sessions and release ownership before either project
# directories or sources change.  A migration failure must not start hosts
# against a mixture of old and converted sessions.
trap 'status=$?; if [ "$status" -ne 0 ]; then
  echo "Update did not finish. Check ./compose ps; resolve the error and rerun ./update." >&2
fi' 0
"$runtime" compose stop

# A host's projects directory used to be its one project.  That project
# moves into it, named after the host, so the container still sees it at
# /projects/HOST, with its lobby links and sessions.
for service in $services; do
  dir=$(projects_dir "$service")
  if [ -e "$dir/.git" ]; then
    case $(readlink -f "$dir") in
      "$PWD"/projects/*) ;;
      *) echo "$dir should hold projects, not be one; see .env.example" >&2
         exit 1 ;;
    esac
    mv "$dir" "$dir.moving" && mkdir "$dir" && mv "$dir.moving" "$dir/$service"
    echo "Moved the $service project to $dir/$service"
    force=1
  fi
  mkdir -p "$dir"
  # Projects from before profile.sh, whose .xdg would otherwise show up as
  # untracked files with the logins in them.
  for project in "$dir"/*/; do
    [ ! -d "$project" ] || exclude "$project" /.xdg/
  done
done

before=$(revisions)
checkout src/niwa "$NIWA_REPO" "$NIWA_BRANCH" "$niwa_rev"
checkout src/gptel "$GPTEL_REPO" "$GPTEL_BRANCH" "$gptel_rev"
after=$(revisions)

if [ "$before" = "$after" ] && [ -z "$force" ]; then
  echo "Up to date: $(git -C src/niwa log -1 --format='niwa %h %s')"
else
  echo "Updated: $(git -C src/niwa log -1 --format='niwa %h %s')"
  echo "         $(git -C src/gptel log -1 --format='gptel %h %s')"
fi

# The only writer of src/: one container, outside both trust boundaries,
# with no network.  keep-id leaves the bytecode owned by this user.
userns=
[ "$runtime" != podman ] || userns=--userns=keep-id
"$runtime" run --rm --network none $userns -v "$PWD/src:/src" \
  --entrypoint emacs "$image" --batch -l /opt/compile.el
prepare_mounts

# Use each service's image, dependencies, user and project mounts, but never
# its daemon entrypoint.  compile.el here only sets up the load path: the
# sources are compiled and read-only.
# The migrator runs once with --user for the user state, which init.el keeps
# on the state volume (-Q skips init.el, so set it the same way), then once
# per project: the old top-level one and every served project directory.  A
# project run covers its sessions and its workspace state under .niwa.  The
# CLI prints per-item outcomes/backups and fails closed on any error.
for service in $services; do
  echo "Checking state migrations for $service"
  "$runtime" compose run --rm --no-deps -T \
    --name "niwa-migration-$service-$$" --entrypoint emacs "$service" \
    --batch -Q \
    -l /opt/compile.el \
    -l /src/niwa/scripts/migrate-sessions.el \
    --eval '(progn
              (setq niwa-user-dir (expand-file-name "niwa/" user-emacs-directory))
              (princ "Checking user state\n")
              (let ((command-line-args-left (list "--user")))
                (niwa-migrate-session-main))
              (dolist (project (cons "/projects"
                                     (directory-files "/projects" t "\\`[^.]")))
                (when (file-directory-p (expand-file-name ".niwa" project))
                  (princ (format "Checking %s\n" project))
                  (let ((command-line-args-left (list project)))
                    (niwa-migrate-session-main)))))'
done

"$runtime" compose up -d --force-recreate 9>&-
